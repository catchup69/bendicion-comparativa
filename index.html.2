<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="description" content="Bendición frente al camino oficial: poner al día bases de Factusol, de 2006 a la versión que elijas, sin perder datos.">
<meta property="og:title" content="Bendición frente al oficial">
<meta property="og:description" content="Dos caminos para poner al día tu Factusol. Uno arrastra la historia. El otro la cura.">
<title>Bendición frente al oficial</title>
<meta name="claude:viewport-fit-sides" content="cover">
<style>
/* Layout: dos carriles paralelos (oficial en ámbar, nuestro en azul) que recorren la historia de una base, de 2006 a la versión que elijas. Mundo oscuro, como la aplicación. */
:root {
  color-scheme: dark;
  --bg: #0b0e14;
  --panel: #121822;
  --panel-2: #0f141d;
  --line: #253041;
  --line-soft: #1b2331;
  --text: #e6e9ef;
  --text-2: #c3cad6;
  --muted: #8f99aa;
  --ours: #5fb2ff;
  --ours-deep: #1f6fd1;
  --off: #f0a24a;
  --ok: #3ecf8e;
  --bad: #ff5c70;
  --fs: #ec0928;
  --sans: "IBM Plex Sans", "Segoe UI", system-ui, sans-serif;
  --cond: "IBM Plex Sans Condensed", "Arial Narrow", "IBM Plex Sans", sans-serif;
  --mono: "IBM Plex Mono", Consolas, monospace;
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; } body { margin: 0; } img { max-width: 100%; } [hidden] { display: none !important; }
body { background: var(--bg); color: var(--text); font-family: var(--sans); font-size: 15px; line-height: 1.55; }
.wrap { max-width: 1180px; margin: 0 auto; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); padding-block: 0; }
h1, h2, h3 { font-family: var(--cond); font-weight: 700; text-wrap: balance; margin: 0; letter-spacing: -0.01em; }
p { margin: 0; }
.eyebrow { font-family: var(--mono); font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
.mono { font-family: var(--mono); }
.tnum { font-variant-numeric: tabular-nums; }

/* ---------- hero ---------- */
.hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--line-soft); }
.hero canvas { position: absolute; inset: 0; width: 100%; height: 100%; opacity: .55; }
.hero .wrap { position: relative; padding-block: 64px 48px; display: grid; gap: 28px; }
.hero h1 { font-size: clamp(40px, 7vw, 86px); line-height: .95; }
.hero h1 .off { color: var(--off); }
.hero h1 .ours { color: var(--ours); }
.hero .lead { max-width: 62ch; color: var(--text-2); font-size: 17px; }
.legend { display: flex; flex-wrap: wrap; gap: 10px 22px; font-size: 13px; color: var(--text-2); }
.legend span { display: inline-flex; align-items: center; gap: 8px; }
.sw { width: 22px; height: 6px; border-radius: 3px; display: inline-block; }

/* ---------- marcador ---------- */
.score { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; background: var(--line-soft); border: 1px solid var(--line-soft); border-radius: 14px; overflow: hidden; }
.score div { background: var(--panel-2); padding: 18px 18px 16px; display: grid; gap: 4px; align-content: start; }
.score b { font-family: var(--cond); font-size: 40px; line-height: 1; color: var(--ours); font-variant-numeric: tabular-nums; }
.score small { color: var(--muted); font-size: 13px; }
@media (max-width: 760px) { .score { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

section { padding-block: 64px 8px; }
.sh { display: grid; gap: 10px; margin-bottom: 26px; max-width: 70ch; }
.sh h2 { font-size: clamp(28px, 4vw, 42px); line-height: 1.05; }
.sh p { color: var(--text-2); }

/* ---------- cómo funciona ---------- */
.how { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0; position: relative; counter-reset: s; }
.how::before { content: ""; position: absolute; left: 10%; right: 10%; top: 23px; height: 2px; background: linear-gradient(90deg, var(--off), var(--ours)); opacity: .45; }
.how .st { position: relative; display: grid; gap: 10px; justify-items: center; text-align: center; padding: 0 10px; }
.how .dot { width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; background: var(--panel); border: 2px solid var(--line); color: var(--text-2); position: relative; z-index: 1; transition: border-color .3s, color .3s, transform .3s; }
.how .st:hover .dot { transform: translateY(-3px); }
.how .st.a .dot { border-color: var(--off); color: var(--off); }
.how .st.b .dot { border-color: var(--ours); color: var(--ours); }
.how .st.g .dot { border-color: var(--ok); color: var(--ok); }
.how .live .dot::after { content: ""; position: absolute; inset: -6px; border-radius: 50%; border: 2px solid var(--ours); opacity: 0; animation: ping 2.4s ease-out infinite; }
@keyframes ping { 0% { transform: scale(.85); opacity: .7; } 100% { transform: scale(1.35); opacity: 0; } }
.how h3 { font-size: 17px; }
.how p { font-size: 13.5px; color: var(--muted); max-width: 24ch; }
@media (max-width: 860px) {
  .how { grid-template-columns: 1fr; gap: 18px; }
  .how::before { left: 23px; right: auto; top: 10px; bottom: 10px; width: 2px; height: auto; background: linear-gradient(180deg, var(--off), var(--ours)); }
  .how .st { grid-template-columns: 48px minmax(0, 1fr); justify-items: start; text-align: left; align-items: center; column-gap: 14px; row-gap: 2px; padding: 0; }
  .how .dot { grid-row: span 2; }
  .how p { max-width: none; }
}

/* ---------- línea del tiempo ---------- */
.tl { background: var(--panel); border: 1px solid var(--line-soft); border-radius: 16px; padding: 22px 20px 18px; overflow-x: auto; }
.tl svg { display: block; min-width: 760px; width: 100%; height: auto; }
.tl .note { margin-top: 12px; font-size: 13px; color: var(--muted); }

/* ---------- destinos ---------- */
.dest { background: var(--panel); border: 1px solid var(--line-soft); border-radius: 16px; padding: 22px 20px; display: grid; gap: 18px; }
.dest-row { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 14px; align-items: center; }
.dest-row .lab { font-family: var(--cond); font-weight: 700; font-size: 16px; }
.dest-row .lab small { display: block; font-family: var(--sans); font-weight: 400; font-size: 12px; color: var(--muted); }
.chips { display: flex; flex-wrap: wrap; gap: 6px; }
.dchip { font-family: var(--mono); font-size: 13px; padding: 7px 10px; border-radius: 8px; border: 1px solid var(--line); color: var(--text-2); background: var(--panel-2); position: relative; transition: transform .2s, border-color .2s; }
.dchip small { font-size: 10.5px; color: var(--muted); margin-left: 4px; }
.dchip.on { border-color: #2a5b93; background: #10233a; color: #cfe5ff; }
.dchip.on:hover { transform: translateY(-2px); border-color: var(--ours); }
.dchip.top { border-color: var(--ours); color: var(--ours); box-shadow: 0 0 0 3px rgba(95,178,255,.12); }
.dchip.fire::after { content: ""; position: absolute; top: -4px; right: -4px; width: 9px; height: 9px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 0 2px var(--panel); }
.dchip.off { border-color: #4d3a1d; background: #241b10; color: #e9cfa8; }
.dchip.soon { border-style: dashed; color: var(--muted); background: transparent; }
.dest .note { font-size: 13px; color: var(--muted); display: flex; flex-wrap: wrap; gap: 6px 18px; }
.dest .note i { display: inline-block; width: 9px; height: 9px; border-radius: 50%; background: var(--ok); margin-right: 6px; vertical-align: 0; }
@media (max-width: 640px) { .dest-row { grid-template-columns: 1fr; gap: 8px; } }

/* ---------- matriz ---------- */
.mx { border: 1px solid var(--line-soft); border-radius: 16px; overflow: hidden; }
.mx-head, .mx-row { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr) minmax(0, 1fr); }
.mx-head { background: var(--panel-2); font-family: var(--mono); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
.mx-head div, .mx-row > div { padding: 14px 16px; min-width: 0; }
.mx-head .h-off { color: var(--off); }
.mx-head .h-ours { color: var(--ours); }
.mx-group { padding: 10px 16px; background: var(--bg); font-family: var(--cond); font-size: 15px; color: var(--text-2); border-top: 1px solid var(--line-soft); letter-spacing: .02em; }
.mx-row { border-top: 1px solid var(--line-soft); background: var(--panel); transition: background .2s; }
.mx-row:hover { background: #151d29; }
.mx-row .what { font-weight: 600; }
.mx-row .what small { display: block; font-weight: 400; color: var(--muted); font-size: 13px; margin-top: 2px; }
.cell { display: flex; gap: 10px; align-items: flex-start; font-size: 14px; color: var(--text-2); }
.cell svg { flex: none; margin-top: 2px; }
@media (max-width: 760px) {
  .mx-head { display: none; }
  .mx-row { grid-template-columns: 1fr; }
  .mx-row > div { padding: 8px 16px; }
  .mx-row .what { padding-top: 14px; }
  .mx-row > div:last-child { padding-bottom: 14px; }
  .cell::before { font-family: var(--mono); font-size: 11px; letter-spacing: .08em; width: 64px; flex: none; margin-top: 3px; }
  .c-off::before { content: "OFICIAL"; color: var(--off); }
  .c-ours::before { content: "NUESTRO"; color: var(--ours); }
}

/* ---------- radiografía de una tabla ---------- */
.xray { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
@media (max-width: 860px) { .xray { grid-template-columns: 1fr; } }
.xcard { background: var(--panel); border: 1px solid var(--line-soft); border-radius: 16px; padding: 20px; display: grid; gap: 14px; min-width: 0; }
.xcard header { display: flex; justify-content: space-between; gap: 10px; align-items: baseline; flex-wrap: wrap; }
.xcard h3 { font-size: 22px; }
.xcard.off h3 { color: var(--off); }
.xcard.ours h3 { color: var(--ours); }
.cols { display: flex; flex-wrap: wrap; gap: 6px; }
.col { font-size: 13px; padding: 6px 10px; border-radius: 6px; background: #1a2230; border: 1px solid var(--line); color: var(--text-2); }
.col.miss { background: transparent; border: 1px dashed var(--bad); color: var(--bad); text-decoration: line-through; opacity: .85; }
.col.new { background: #10233a; border-color: #2a5b93; color: var(--ours); }
.xcard .cap { font-size: 13.5px; color: var(--muted); }
.bars { display: grid; gap: 10px; }
.bar { display: grid; grid-template-columns: 130px minmax(0, 1fr) 52px; gap: 10px; align-items: center; font-size: 13px; }
.bar .tr { height: 10px; border-radius: 5px; background: #1a2230; overflow: hidden; }
.bar .tr i { display: block; height: 100%; border-radius: 5px; width: 0; transition: width 1.4s cubic-bezier(.2,.8,.2,1); }
.bar .v { text-align: right; font-family: var(--mono); color: var(--text-2); }
@media (max-width: 480px) { .bar { grid-template-columns: 96px minmax(0, 1fr) 44px; } }

/* ---------- datos protegidos ---------- */
.saves { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
@media (max-width: 900px) { .saves { grid-template-columns: 1fr; } }
.save { border-radius: 16px; padding: 20px; background: linear-gradient(180deg, #111a27, var(--panel-2)); border: 1px solid var(--line-soft); display: grid; gap: 12px; align-content: start; min-width: 0; }
.save h3 { font-size: 20px; }
.save p { color: var(--text-2); font-size: 14px; }
.flow { display: grid; grid-template-columns: minmax(0, 1fr) 26px minmax(0, 1fr); align-items: center; gap: 6px; }
.box { border-radius: 10px; padding: 10px; font-size: 12.5px; min-width: 0; }
.box b { display: block; font-family: var(--mono); font-size: 11px; letter-spacing: .08em; margin-bottom: 4px; }
.box.o { background: #241b10; border: 1px solid #4d3a1d; color: #e9cfa8; }
.box.o b { color: var(--off); }
.box.n { background: #0f2238; border: 1px solid #23507f; color: #cfe5ff; }
.box.n b { color: var(--ours); }
.flow .arrow { color: var(--muted); text-align: center; font-family: var(--mono); }

/* ---------- límites ---------- */
.limits { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
@media (max-width: 760px) { .limits { grid-template-columns: 1fr; } }
.limit { border: 1px dashed var(--line); border-radius: 12px; padding: 14px 16px; color: var(--text-2); font-size: 14px; display: grid; gap: 4px; align-content: start; }
.limit b { font-family: var(--cond); font-size: 16px; color: var(--text); }

/* ---------- sello ---------- */
.sealwrap { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: 36px; align-items: center; background: radial-gradient(120% 140% at 0% 0%, #13253d 0%, var(--panel) 55%); border: 1px solid var(--line-soft); border-radius: 20px; padding: 32px; }
@media (max-width: 760px) { .sealwrap { grid-template-columns: 1fr; justify-items: center; text-align: left; padding: 24px 18px; } }
.seal { width: 240px; max-width: 100%; aspect-ratio: 1; }
.seal .ring { transform-origin: 120px 120px; animation: spin 40s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.sealtxt { display: grid; gap: 14px; }
.sealtxt h2 { font-size: clamp(26px, 3.4vw, 36px); }
.sealtxt ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; }
.sealtxt li { display: flex; gap: 10px; color: var(--text-2); font-size: 14.5px; }
.sealtxt li svg { flex: none; margin-top: 3px; }

footer { padding-block: 48px 64px; color: var(--muted); font-size: 13px; }
footer .wrap { display: grid; gap: 6px; }

.reveal { opacity: 1; transform: none; transition: opacity .7s ease, transform .7s ease; }
.js .reveal.pending { opacity: .001; transform: translateY(14px); }
@media (prefers-reduced-motion: reduce) {
  .seal .ring, .how .live .dot::after { animation: none; }
  .reveal, .bar .tr i { transition: none; }
  .js .reveal.pending { opacity: 1; transform: none; }
}
</style>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+Condensed:wght@500;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap">
</head>
<body>
<header class="hero">
  <canvas id="bg" aria-hidden="true"></canvas>
  <div class="wrap">
    <div class="eyebrow">Factusol Forensics · método de Bendición · comparativa v1 · 01-11-2026</div>
    <h1>Dos caminos para poner al día tu Factusol.<br><span class="off">Uno arrastra la historia.</span><br><span class="ours">El otro la cura.</span></h1>
    <p class="lead">Lo que hace el camino oficial de Factusol y lo que hace la Bendición, medido sobre bases reales y de demostración de 2006 a 2025. Cada resultado se comprueba abriendo la base en su versión de destino.</p>
    <div class="legend">
      <span><i class="sw" style="background:var(--off)"></i>Camino oficial</span>
      <span><i class="sw" style="background:var(--ours)"></i>Bendición</span>
      <span><i class="sw" style="background:var(--ok)"></i>Comprobado</span>
      <span><i class="sw" style="background:var(--bad)"></i>Se pierde o falta</span>
    </div>
    <div class="score">
      <div><b data-n="32">32</b><small>ediciones de Factusol reconocidas, de 2006 a 2026</small></div>
      <div><b data-n="10">10</b><small>versiones de destino a elegir, de 2017 a 2026, con sus ediciones EV y EL</small></div>
      <div><b data-n="0">0</b><small>registros perdidos en las pruebas</small></div>
      <div><b data-n="0">0</b><small>diferencias de estructura frente a una base nacida en esa versión</small></div>
    </div>
  </div>
</header>

<main>
  <section class="wrap reveal">
    <div class="sh">
      <div class="eyebrow">01 · Cómo funciona</div>
      <h2>Cinco pasos. Tu original no se toca en ninguno.</h2>
    </div>
    <div class="how">
      <div class="st a"><span class="dot"><svg width="20" height="20" viewBox="0 0 20 20"><path d="M10 13V3M6 7l4-4 4 4M3 13v3h14v-3" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></span><h3>Copia de tus datos</h3><p>La carpeta de datos o la copia de seguridad que hace Factusol.</p></div>
      <div class="st a"><span class="dot"><svg width="20" height="20" viewBox="0 0 20 20"><circle cx="9" cy="9" r="5.5" stroke="currentColor" stroke-width="1.8" fill="none"/><path d="M13 13l4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span><h3>Diagnóstico</h3><p>Qué empresas y ejercicios hay, de qué versión es cada uno y qué arrastra.</p></div>
      <div class="st b"><span class="dot"><svg width="20" height="20" viewBox="0 0 20 20"><path d="M4 10h11M11 6l4 4-4 4" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></span><h3>Destino y alcance</h3><p>Eliges la versión y qué llevar: todo, o por empresas, años y áreas.</p></div>
      <div class="st b live"><span class="dot"><svg width="20" height="20" viewBox="0 0 20 20"><path d="M4 10.5l4 4 8-9" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg></span><h3>Bendición</h3><p>Cada ejercicio se rehace sobre una base nueva de esa versión y se comprueba.</p></div>
      <div class="st g"><span class="dot"><svg width="20" height="20" viewBox="0 0 20 20"><circle cx="10" cy="8" r="5" stroke="currentColor" stroke-width="1.8" fill="none"/><path d="M7 12l-1.5 5L10 15l4.5 2L13 12" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linejoin="round"/></svg></span><h3>Entrega</h3><p>Datos listos para abrir, copia en .zip, informe y sello de calidad.</p></div>
    </div>
  </section>

  <section class="wrap reveal">
    <div class="sh">
      <div class="eyebrow">02 · De dónde puede venir tu base</div>
      <h2>El oficial necesita escalones. Nosotros, uno.</h2>
      <p>Cada fila es un camino; cada tramo, las ediciones de Factusol desde las que se puede salir.</p>
    </div>
    <div class="tl">
      <svg viewBox="0 0 1000 230" role="img" aria-label="Cobertura por años de origen: oficial frente a Bendición">
        <g font-family="IBM Plex Mono, monospace" font-size="12" fill="#8f99aa">
          <text x="150" y="22">2006</text><text x="245" y="22">2009</text><text x="340" y="22">2012</text><text x="435" y="22">2015</text>
          <text x="505" y="22">2016 EV</text><text x="600" y="22">2018</text><text x="700" y="22">2020</text><text x="800" y="22">2022</text><text x="900" y="22">2025</text>
        </g>
        <g stroke="#1b2331"><line x1="160" y1="30" x2="160" y2="206"/><line x1="255" y1="30" x2="255" y2="206"/><line x1="350" y1="30" x2="350" y2="206"/><line x1="445" y1="30" x2="445" y2="206"/><line x1="525" y1="30" x2="525" y2="206"/><line x1="610" y1="30" x2="610" y2="206"/><line x1="710" y1="30" x2="710" y2="206"/><line x1="810" y1="30" x2="810" y2="206"/><line x1="915" y1="30" x2="915" y2="206"/></g>
        <defs>
          <pattern id="hatch" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="8" height="8" fill="#2a1418"/><line x1="0" y1="0" x2="0" y2="8" stroke="#ff5c70" stroke-width="3" opacity=".55"/></pattern>
          <linearGradient id="gOurs" x1="0" x2="1"><stop offset="0" stop-color="#1f6fd1"/><stop offset="1" stop-color="#5fb2ff"/></linearGradient>
        </defs>
        <!-- carril oficial -->
        <text x="0" y="74" font-family="IBM Plex Sans Condensed, sans-serif" font-weight="700" font-size="17" fill="#f0a24a">OFICIAL</text>
        <text x="0" y="92" font-family="IBM Plex Sans, sans-serif" font-size="12" fill="#8f99aa">importador + actualizador</text>
        <rect x="150" y="56" width="355" height="36" rx="8" fill="url(#hatch)" stroke="#ff5c70" stroke-opacity=".5"/>
        <text x="164" y="79" font-family="IBM Plex Sans, sans-serif" font-size="12.5" fill="#ffd0d6">Antes hay que instalar 2016 EV y actualizar</text>
        <rect x="510" y="56" width="40" height="36" rx="8" fill="#f0a24a"/>
        <text x="530" y="110" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="11" fill="#f0a24a">importador</text>
        <rect x="556" y="56" width="384" height="36" rx="8" fill="#f0a24a" fill-opacity=".22" stroke="#f0a24a" stroke-opacity=".7"/>
        <text x="572" y="79" font-family="IBM Plex Sans, sans-serif" font-size="12.5" fill="#f6d2a6">Solo el actualizador · cambia la base original</text>
        <!-- carril nuestro -->
        <text x="0" y="160" font-family="IBM Plex Sans Condensed, sans-serif" font-weight="700" font-size="17" fill="#5fb2ff">BENDICIÓN</text>
        <text x="0" y="178" font-family="IBM Plex Sans, sans-serif" font-size="12" fill="#8f99aa">sobre una copia</text>
        <rect x="150" y="142" width="790" height="36" rx="8" fill="url(#gOurs)"/>
        <text x="164" y="165" font-family="IBM Plex Sans, sans-serif" font-size="12.5" font-weight="600" fill="#06121f">2006–2015 · directo, en un solo paso</text>
        <text x="572" y="165" font-family="IBM Plex Sans, sans-serif" font-size="12.5" font-weight="600" fill="#06121f">2016 EV a 2025 · original intacto</text>
      </svg>
      <p class="note">Desde 2017 el importador oficial ya no acepta bases: todo pasa por el actualizador, que trabaja sobre la base original.</p>
    </div>
  </section>

  <section class="wrap reveal">
    <div class="sh">
      <div class="eyebrow">03 · A dónde puede ir</div>
      <h2>A la versión que tengas, no solo a la última.</h2>
      <p>El oficial te lleva a la versión que instalas, y para ir paso a paso hay que instalar cada una. La Bendición lleva tu base directamente a la versión que elijas.</p>
    </div>
    <div class="dest">
      <div class="dest-row">
        <div class="lab" style="color:var(--ours)">Disponibles<small>con sus ediciones EV y EL</small></div>
        <div class="chips">
          <span class="dchip on">2017<small>+EV</small></span><span class="dchip on">2018<small>+EV</small></span><span class="dchip on">2019<small>+EV</small></span><span class="dchip on">2020<small>+EV</small></span><span class="dchip on">2021<small>+EL</small></span>
          <span class="dchip on fire">2022<small>= 2022 EV</small></span><span class="dchip on">2023<small>+EV</small></span><span class="dchip on">2024<small>+EV</small></span><span class="dchip on">2025</span><span class="dchip top fire">2026</span>
        </div>
      </div>
      <div class="dest-row">
        <div class="lab" style="color:var(--muted)">Próximamente</div>
        <div class="chips"><span class="dchip soon">2016 EV y anteriores</span><span class="dchip soon">2027, cuando se publique</span></div>
      </div>
      <p class="note"><span><i></i>Probado abriendo en esa versión una base real de 2009–2016 bendecida: sin un solo aviso.</span><span>Solo se sube de versión. Bajar es otro servicio, en preparación.</span></p>
    </div>
  </section>

  <section class="wrap reveal">
    <div class="sh">
      <div class="eyebrow">04 · Capacidad a capacidad</div>
      <h2>Qué hace cada uno</h2>
      <p>Verde: lo hace. Ámbar: lo hace a medias o con un coste. Rojo: no lo hace o se pierde algo.</p>
    </div>
    <div class="mx" id="mx"></div>
  </section>

  <section class="wrap reveal">
    <div class="sh">
      <div class="eyebrow">05 · Radiografía de una tabla</div>
      <h2>Mismo sello, distinta base</h2>
      <p>Los números de serie de los albaranes, en una empresa que llegó a 2026 desde Factusol 2017. Las dos dicen ser 2026; por dentro no son iguales.</p>
    </div>
    <div class="xray">
      <article class="xcard off">
        <header><h3>Actualizada por el oficial</h3><span class="eyebrow">números de serie</span></header>
        <div class="cols">
          <span class="col">tipo</span><span class="col">documento</span><span class="col">línea</span><span class="col">nº de serie</span><span class="col">fabricación</span><span class="col">caducidad</span><span class="col">cantidad</span>
          <span class="col miss">fecha</span><span class="col miss">almacén</span><span class="col miss">artículo</span>
        </div>
        <p class="cap">Le faltan 3 campos que tiene una base nacida en 2026. Lo mismo pasa en otras tablas de lotes, artículos, familias y empresa: 42 campos en total. Además conserva restos de versiones antiguas.</p>
      </article>
      <article class="xcard ours">
        <header><h3>Bendecida</h3><span class="eyebrow">números de serie</span></header>
        <div class="cols">
          <span class="col">tipo</span><span class="col">documento</span><span class="col">línea</span><span class="col">nº de serie</span><span class="col">fabricación</span><span class="col">caducidad</span><span class="col">cantidad</span>
          <span class="col new">fecha</span><span class="col new">almacén</span><span class="col new">artículo</span>
        </div>
        <p class="cap">Idéntica a una base recién creada en Factusol 2026: 0 diferencias. Sin restos.</p>
      </article>
    </div>
    <div class="xcard" style="margin-top:18px">
      <header><h3>Campos de 2026 presentes tras subir desde 2017</h3><span class="eyebrow">en las tablas afectadas</span></header>
      <div class="bars">
        <div class="bar"><span>Oficial</span><span class="tr"><i data-w="0" style="background:var(--off)"></i></span><span class="v">−42</span></div>
        <div class="bar"><span>Bendición</span><span class="tr"><i data-w="100" style="background:linear-gradient(90deg,var(--ours-deep),var(--ours))"></i></span><span class="v">100 %</span></div>
      </div>
    </div>
  </section>

  <section class="wrap reveal">
    <div class="sh">
      <div class="eyebrow">06 · Datos que cuidamos</div>
      <h2>Donde el oficial pierde, deja a medias o pregunta</h2>
    </div>
    <div class="saves">
      <article class="save">
        <h3>Números de serie y lotes</h3>
        <div class="flow">
          <div class="box o"><b>OFICIAL</b>Desde bases anteriores a 2016 EV no hay camino directo: primero hay que instalar 2016 EV y actualizar.</div>
          <div class="arrow">→</div>
          <div class="box n"><b>BENDICIÓN</b>Pasan todos, cada uno a su sitio. Si alguno no pasara, el informe lo diría.</div>
        </div>
        <p>Comprobado en bases de 2009 a 2016: todos los lotes y números de serie, abiertos después en Factusol.</p>
      </article>
      <article class="save">
        <h3>NIF y país en cada documento</h3>
        <div class="flow">
          <div class="box o"><b>OFICIAL</b>Los deja vacíos. Factusol pregunta «qué tipo de NIF» al volver a guardar.</div>
          <div class="arrow">→</div>
          <div class="box n"><b>BENDICIÓN</b>Se toman de la ficha del cliente o proveedor, como haría Factusol.</div>
        </div>
        <p>Facturas, albaranes, presupuestos, pedidos y compras. También con proveedores extranjeros.</p>
      </article>
      <article class="save">
        <h3>Lo que ya venía roto</h3>
        <div class="flow">
          <div class="box o"><b>OFICIAL</b>No avisa. Lo descubres al abrir un documento.</div>
          <div class="arrow">→</div>
          <div class="box n"><b>BENDICIÓN</b>Se respeta tal cual y el informe lo señala: qué es, dónde y cuántos.</div>
        </div>
        <p>Por ejemplo, líneas de factura que apuntan a un artículo borrado hace años. Tus documentos no cambian.</p>
      </article>
      <article class="save">
        <h3>Tu lista de empresas</h3>
        <div class="flow">
          <div class="box o"><b>OFICIAL</b>Pone al día los datos generales solo en parte.</div>
          <div class="arrow">→</div>
          <div class="box n"><b>BENDICIÓN</b>Datos generales al día y tus empresas dadas de alta.</div>
        </div>
        <p>Abres Factusol y tus empresas y ejercicios ya están en la lista.</p>
      </article>
    </div>
  </section>

  <section class="wrap reveal">
    <div class="sh">
      <div class="eyebrow">07 · Con honestidad</div>
      <h2>Lo que aún no hacemos</h2>
    </div>
    <div class="limits">
      <div class="limit"><b>Destinos anteriores a 2017</b>Llevar una base a 2016 EV o antes. En preparación, empezando por 2016 EV.</div>
      <div class="limit"><b>Bajar de versión</b>La Reconciliación, de una versión moderna a otra anterior, está en diseño.</div>
      <div class="limit"><b>Resto de la familia</b>ContaSOL, NominaSOL, TPVSOL y EstimaSOL; GestorSOL anterior a 2020.</div>
      <div class="limit"><b>Factusol 2027</b>Se añadirá cuando se publique, con el mismo método de prueba.</div>
      <div class="limit"><b>Factusol 2008</b>Sus bases se reconocen; falta la prueba con una empresa con datos.</div>
      <div class="limit"><b>Una diferencia sin mejora</b>En GestorSOL 2024 EV el oficial corrige un dato interno en la propia base; nosotros lo dejamos como venía. Abre igual.</div>
    </div>
  </section>

  <section class="wrap reveal">
    <div class="sealwrap">
      <svg class="seal" viewBox="0 0 240 240" role="img" aria-label="Sello de calidad de ejemplo">
        <defs>
          <path id="circ" d="M120,120 m-92,0 a92,92 0 1,1 184,0 a92,92 0 1,1 -184,0"/>
          <radialGradient id="sg" cx="50%" cy="40%" r="60%"><stop offset="0" stop-color="#1d3a5e"/><stop offset="1" stop-color="#0d1828"/></radialGradient>
        </defs>
        <circle cx="120" cy="120" r="116" fill="url(#sg)" stroke="#5fb2ff" stroke-opacity=".5"/>
        <g class="ring">
          <text font-family="IBM Plex Mono, monospace" font-size="12.5" letter-spacing="3" fill="#9cc9ff"><textPath href="#circ" textLength="570">BASE BENDECIDA · ORIGINAL INTACTO · 0 REGISTROS PERDIDOS ·</textPath></text>
        </g>
        <circle cx="120" cy="120" r="74" fill="none" stroke="#5fb2ff" stroke-width="2"/>
        <circle cx="120" cy="120" r="68" fill="#0b1422" stroke="#ec0928" stroke-width="4"/>
        <text x="120" y="112" text-anchor="middle" font-family="IBM Plex Sans Condensed, sans-serif" font-weight="700" font-size="34" fill="#e6e9ef">FS</text>
        <text x="120" y="134" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="11" fill="#ff5c70">2016 EV → 2022</text>
        <path d="M100 148 l12 12 l26 -26" fill="none" stroke="#3ecf8e" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <div class="sealtxt">
        <div class="eyebrow">08 · Lo que recibe el cliente</div>
        <h2>Tus datos listos, un informe claro y un sello que se puede comprobar</h2>
        <ul>
          <li><svg width="16" height="16" viewBox="0 0 16 16"><circle cx="8" cy="8" r="7" fill="#3ecf8e"/><path d="M4.5 8.2l2.3 2.3 4.7-4.8" stroke="#06121f" stroke-width="1.8" fill="none"/></svg>Los datos listos para abrir en la versión elegida, también en un .zip</li>
          <li><svg width="16" height="16" viewBox="0 0 16 16"><circle cx="8" cy="8" r="7" fill="#3ecf8e"/><path d="M4.5 8.2l2.3 2.3 4.7-4.8" stroke="#06121f" stroke-width="1.8" fill="none"/></svg>El original intacto, con su huella antes y después</li>
          <li><svg width="16" height="16" viewBox="0 0 16 16"><circle cx="8" cy="8" r="7" fill="#3ecf8e"/><path d="M4.5 8.2l2.3 2.3 4.7-4.8" stroke="#06121f" stroke-width="1.8" fill="none"/></svg>Antes y después de cada ejercicio, área por área</li>
          <li><svg width="16" height="16" viewBox="0 0 16 16"><circle cx="8" cy="8" r="7" fill="#3ecf8e"/><path d="M4.5 8.2l2.3 2.3 4.7-4.8" stroke="#06121f" stroke-width="1.8" fill="none"/></svg>Lo que ya traía la base y lo que se dejó fuera, explicado</li>
          <li><svg width="16" height="16" viewBox="0 0 16 16"><circle cx="8" cy="8" r="7" fill="#3ecf8e"/><path d="M4.5 8.2l2.3 2.3 4.7-4.8" stroke="#06121f" stroke-width="1.8" fill="none"/></svg>Solo recuentos: ningún dato de sus clientes en el informe</li>
        </ul>
      </div>
    </div>
  </section>
</main>

<footer>
  <div class="wrap">
    <span>Pruebas del 20 de octubre al 1 de noviembre de 2026: empresas de demostración de cada edición de Factusol, una empresa real con 15 años de historia y bases antiguas de 2006 a 2015, abiertas en Factusol 2026 y 2022.</span>
    <span>Factusol es una marca de su propietario. Este proyecto es independiente y no está afiliado a él.</span>
  </div>
</footer>

<script>
(function () {
  document.documentElement.classList.add('js');
  var OK = '<svg width="18" height="18" viewBox="0 0 18 18" aria-label="sí"><circle cx="9" cy="9" r="8" fill="#3ecf8e"/><path d="M5 9.3l2.6 2.6 5.4-5.5" stroke="#06121f" stroke-width="2" fill="none" stroke-linecap="round"/></svg>';
  var HALF = '<svg width="18" height="18" viewBox="0 0 18 18" aria-label="a medias"><circle cx="9" cy="9" r="8" fill="none" stroke="#f0a24a" stroke-width="2"/><path d="M9 1a8 8 0 0 1 0 16z" fill="#f0a24a"/></svg>';
  var NO = '<svg width="18" height="18" viewBox="0 0 18 18" aria-label="no"><circle cx="9" cy="9" r="8" fill="#ff5c70"/><path d="M6 6l6 6M12 6l-6 6" stroke="#2a0a10" stroke-width="2" stroke-linecap="round"/></svg>';
  var ic = { ok: OK, half: HALF, no: NO };
  var rows = [
    ['Origen y destino'],
    ['Bases 2006–2015', 'Antes de 2016 EV', 'no', 'Hay que instalar 2016 EV y dejar que actualice; en una instalación limpia se niega.', 'ok', 'Directo, en un solo paso.'],
    ['Bases 2016 EV a 2025', 'FactuSOL y GestorSOL', 'half', 'Importador solo para 2016 EV; desde 2017, el actualizador al abrir la empresa.', 'ok', 'Todas las ediciones, comprobadas una a una.'],
    ['Versión de destino', '', 'half', 'La que instales. Para ir paso a paso, instalar cada una.', 'ok', 'La que elijas, de 2017 a 2026, sin instalar las intermedias.'],
    ['Cómo trabaja'],
    ['El original', '', 'no', 'Se modifica en su sitio. Desde 2024 EV, sin asistente ni copia.', 'ok', 'Nunca se toca. Su huella se comprueba al terminar.'],
    ['Qué se traspasa', '', 'no', 'Todo o nada.', 'ok', 'Todo, o por empresas, años y áreas, sin dejar documentos sin su ficha.'],
    ['Antes de empezar', '', 'no', 'No sabes qué va a pasar hasta que actualiza.', 'ok', 'Diagnóstico gratuito: qué hay, de qué versión y qué arrastra.'],
    ['Informe final', '', 'no', 'Ninguno.', 'ok', 'Antes y después de cada ejercicio, avisos heredados y huellas. Si algo no cuadra, el ejercicio no se entrega.'],
    ['Resultado'],
    ['Estructura', 'Frente a una base nacida en esa versión', 'half', 'Arrastra restos antiguos; desde una base de 2017 le faltan 42 campos.', 'ok', 'Idéntica a la nacida: 0 diferencias.'],
    ['Tus datos', '', 'ok', 'Los conserva.', 'ok', 'Los mismos registros, contados antes y después: 0 perdidos.'],
    ['Lista de empresas', 'Datos generales', 'half', 'Al día solo en parte.', 'ok', 'Al día, con tus empresas dadas de alta.'],
    ['Lotes y números de serie', 'Bases hasta 2016', 'half', 'Hay que pasar antes por 2016 EV.', 'ok', 'Pasan todos, sin pasar por 2016 EV.'],
    ['Tipo de NIF y país', 'En cada documento', 'half', 'Los deja vacíos; Factusol pregunta al guardar.', 'ok', 'Tomados de la ficha.'],
    ['Copia de seguridad', '', 'half', 'Depende de la versión y de que la hagas tú.', 'ok', 'El resultado en .zip y el original sin tocar.']
  ];
  var h = '<div class="mx-head"><div>Capacidad</div><div class="h-off">Oficial</div><div class="h-ours">Bendición</div></div>';
  rows.forEach(function (r) {
    if (r.length === 1) { h += '<div class="mx-group">' + r[0] + '</div>'; return; }
    h += '<div class="mx-row"><div class="what">' + r[0] + (r[1] ? '<small>' + r[1] + '</small>' : '') + '</div>' +
      '<div class="cell c-off">' + ic[r[2]] + '<span>' + r[3] + '</span></div>' +
      '<div class="cell c-ours">' + ic[r[4]] + '<span>' + r[5] + '</span></div></div>';
  });
  document.getElementById('mx').innerHTML = h;

  var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;

  // barras
  function fillBars() { document.querySelectorAll('.bar .tr i').forEach(function (i) { i.style.width = i.getAttribute('data-w') + '%'; }); }
  setTimeout(fillBars, 300);

  // contadores
  if (!reduce) document.querySelectorAll('.score b').forEach(function (b) {
    var n = +b.getAttribute('data-n'); if (!n) return; var k = 0; b.textContent = '0';
    var iv = setInterval(function () { k = Math.min(n, k + Math.max(1, Math.round(n / 30))); b.textContent = k; if (k >= n) clearInterval(iv); }, 28);
  });

  // aparición suave (el contenido ya es visible sin JS)
  if ('IntersectionObserver' in window && !reduce) {
    var els = document.querySelectorAll('main .reveal');
    var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.remove('pending'); io.unobserve(e.target); } }); }, { rootMargin: '0px 0px -8% 0px' });
    els.forEach(function (el, i) { if (i > 0) { el.classList.add('pending'); io.observe(el); } });
    setTimeout(function () { els.forEach(function (el) { el.classList.remove('pending'); }); }, 4000);
  }

  // fondo: dos corrientes de partículas (ámbar que se dispersa, azul que se ordena)
  var c = document.getElementById('bg'), x = c.getContext('2d'), W, H, P = [];
  function size() { var r = c.getBoundingClientRect(); W = c.width = r.width * devicePixelRatio; H = c.height = r.height * devicePixelRatio; }
  size(); window.addEventListener('resize', size);
  for (var i = 0; i < 90; i++) P.push({ t: Math.random(), y: Math.random(), s: .0006 + Math.random() * .0012, o: i % 2 });
  function draw() {
    x.clearRect(0, 0, W, H);
    P.forEach(function (p) {
      p.t += p.s; if (p.t > 1) { p.t = 0; p.y = Math.random(); }
      var px = p.t * W, py;
      if (p.o) { py = (p.y + Math.sin(p.t * 9 + p.y * 20) * .05 * p.t) * H; x.fillStyle = 'rgba(240,162,74,' + (.5 * (1 - p.t)) + ')'; }
      else { var lane = Math.round(p.y * 6) / 6; py = (p.y + (lane - p.y) * p.t) * H; x.fillStyle = 'rgba(95,178,255,' + (.25 + .5 * p.t) + ')'; }
      x.beginPath(); x.arc(px, py, 1.6 * devicePixelRatio, 0, 6.283); x.fill();
    });
    if (!reduce) requestAnimationFrame(draw);
  }
  draw();
})();
</script>

